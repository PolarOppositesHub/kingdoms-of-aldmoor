e":"anvil","type":"prop","x":2232,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"anvil"}]},{"id":35,"name":"well","type":"prop","x":1832,"y":2254,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"well"}]},{"id":36,"name":"firepit","type":"prop","x":1928,"y":2318,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":37,"name":"banner","type":"prop","x":1928,"y":2062,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":38,"name":"barrel","type":"prop","x":1608,"y":2190,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"barrel"}]},{"id":39,"name":"crate","type":"prop","x":2344,"y":2190,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"crate"}]},{"id":40,"name":"barrel","type":"prop","x":2216,"y":1870,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"barrel"}]},{"id":41,"name":"Mead Hall","type":"sign","x":1624,"y":2702,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Jarl Freya's mead hall. Stone, not a castle. The skald is inside. She would rather fill the hall with traders than with a war-band."}]},{"id":42,"name":"Frosthearth Inn","type":"sign","x":1544,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Frosthearth Inn. Hilda Venn keeps the fire. Sefa Chart sells maps of the hold. If you fall in combat, you wake in the yard."}]},{"id":43,"name":"Brenna's Goods","type":"sign","x":1736,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Brenna's Goods. Pelts, bandages, and a draught that costs more than bread."}]},{"id":44,"name":"Ivar's Forge","type":"sign","x":2168,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Ivar's Forge. The smith works the outdoor anvil. Marta sells inside, at the price on the slate."}]},{"id":45,"name":"Signe's Needles","type":"sign","x":2008,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Signe's Needles. Cloth and leather, cut and stitched."}]},{"id":46,"name":"Warrior Guild","type":"sign","x":1592,"y":2910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Warrior Guild. Eirik Stonehand is guildmaster. The hall is still new."}]},{"id":47,"name":"Wizard Hall","type":"sign","x":2040,"y":2686,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Wizard Hall. Ingrid Mire keeps the pages. Barbarians are not taught here."}]},{"id":48,"name":"Shaman Hall","type":"sign","x":2264,"y":2686,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Shaman Hall. Torunn Ash. Slows, mends, and the burn that stays."}]},{"id":49,"name":"Rogue Hall","type":"sign","x":2040,"y":2910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Rogue Hall. Sable Venn. Speak quietly."}]},{"id":50,"name":"Berserker Hall","type":"sign","x":2264,"y":2910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Berserker Hall. Hroth Keld. Rage is a tool, not a mood."}]},{"id":51,"name":"Warden Hall","type":"sign","x":1736,"y":2910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Warden Hall. Bjorn Pale. Fists, a staff, and a snow wolf."}]},{"id":52,"name":"Sigrid's Steel","type":"sign","x":2376,"y":2174,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Sigrid's Steel. Yrsa works the upgrades. The rune-blade, if you earn it, is hers to give."}]},{"id":53,"name":"North gate","type":"sign","x":1800,"y":1870,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"North gate of Hoffender. Sigrun Ashmantle captains the scouts. Soren Bram keeps the gate for Jarl Freya. The Frostmere Wilds begin on the road."}]},{"id":54,"name":"Hoffender Bay","type":"sign","x":1176,"y":2606,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_inn"},{"name":"text","type":"string","value":"Hoffender Bay. The docks are tied. No boat runs to Thornhaven yet. Gull Point and Saltwind Head keep the worst of the weather off the water."}]},{"id":55,"name":"Smugglers' Cove","type":"sign","x":760,"y":3454,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Smugglers' Cove. A narrow cut behind the headland. The cave mouth at the back is not mapped. The trail comes off the south road."}]},{"id":56,"name":"Hoffender","type":"label","x":1928,"y":2286,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":57,"name":"Mead Hall","type":"label","x":1688,"y":2542,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":58,"name":"Frostmere Wilds","type":"label","x":1928,"y":1262,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":59,"name":"Whitepine","type":"label","x":3144,"y":2094,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":60,"name":"Scout Camp","type":"label","x":2184,"y":942,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":61,"name":"Icebound Cairns","type":"label","x":1192,"y":590,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":62,"name":"Rimeheart","type":"label","x":3144,"y":366,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":63,"name":"Hoffender Bay","type":"label","x":1016,"y":2494,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":64,"name":"Gull Point","type":"label","x":920,"y":2334,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":65,"name":"Saltwind Head","type":"label","x":952,"y":2846,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":66,"name":"cairn-rock","type":"prop","x":2120,"y":958,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":67,"name":"cairn-rock","type":"prop","x":2184,"y":958,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":68,"name":"cairn-rock","type":"prop","x":2120,"y":1006,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":69,"name":"cairn-rock","type":"prop","x":2184,"y":1006,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":70,"name":"campfire","type":"prop","x":2152,"y":974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":71,"name":"camp-crate","type":"prop","x":2168,"y":990,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"crate"}]},{"id":72,"name":"Frozen journal","type":"sign","x":2168,"y":974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"A journal frozen open. The last page is stiff. \"Blue lights under the ice, where the creek dies in a black lake. I am going to look.\" The name under it is a scout of Sigrun's, and then nothing."}]},{"id":73,"name":"Barrow door","type":"door","x":872,"y":286,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"barrow"},{"name":"toX","type":"float","value":392},{"name":"toY","type":"float","value":654}]},{"id":74,"name":"The Barrow","type":"sign","x":904,"y":286,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Barrow. The door is a dark cut in the cairn. Torsten Crowe is said to keep the last room. Mira Palehand walks the ground outside."}]},{"id":75,"name":"Smugglers' Cove","type":"label","x":792,"y":3406,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":76,"name":"Frostfang Reach","type":"seam","x":1704,"y":62,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The road to Frostfang Reach is not yet open. The Ogre Highlands lie beyond it, in the snow and the bare rock."}]},{"id":77,"name":"Wyrmrest","type":"seam","x":4040,"y":2446,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The road to Wyrmrest is not yet open. The pines thin here, and the stone of the foothills starts."}]},{"id":78,"name":"Thornhaven","type":"seam","x":2248,"y":4062,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The road south to Graymoor Hold and Thornhaven is not yet open. The snow is already slush, and the first fields are mud."}]},{"id":79,"name":"Valdoria","type":"seam","x":3976,"y":3790,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The track to the Kingdom of Valdoria and Blackpine Tower is not yet open. The snow has given way to pine and grass."}]},{"id":80,"name":"young_wolf","type":"mob","x":2056,"y":2974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"young_wolf"},{"name":"sprite","type":"string","value":"young_wolf"}]},{"id":81,"name":"young_wolf","type":"mob","x":1992,"y":1598,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"young_wolf"},{"name":"sprite","type":"string","value":"young_wolf"}]},{"id":82,"name":"young_wolf","type":"mob","x":1864,"y":1854,"width":0,"height":0,"rotation":0,"visible":true