 quietly."}]},{"id":113,"name":"Berserker Hall","type":"sign","x":232,"y":2478,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Berserker Hall. Hroth Keld. Rage is a tool, not a mood."}]},{"id":114,"name":"Warden Hall","type":"sign","x":488,"y":2478,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Warden Hall. Bjorn Pale. Fists, a staff, and a snow wolf."}]},{"id":115,"name":"Sigrid's Steel","type":"sign","x":808,"y":2478,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_shop"},{"name":"text","type":"string","value":"Sigrid's Steel. Weapons. Armor is Ivar's forge, north of here."}]},{"id":116,"name":"Frostmere Wilds this way","type":"sign","x":424,"y":1518,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Frostmere Wilds this way. North, through the gate. Wolves are on the road."}]},{"id":117,"name":"Hoffender this way","type":"sign","x":552,"y":1518,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_inn"},{"name":"text","type":"string","value":"Hoffender this way. The gate is south. Jarl Freya keeps the mead hall."}]},{"id":118,"name":"boulder","type":"prop","x":776,"y":62,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":119,"name":"pine","type":"prop","x":680,"y":942,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"tree"}]},{"id":120,"name":"pine","type":"prop","x":936,"y":798,"width":0,"height":0,"rotation":0,"visi