3918}]},{"id":2,"name":"north","type":"spawn","x":2056,"y":270,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":3,"name":"From the grass track","type":"door","x":3976,"y":1742,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"hoffender"},{"name":"toX","type":"float","value":3848},{"name":"toY","type":"float","value":3662}]},{"id":4,"name":"east","type":"spawn","x":3784,"y":1742,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":5,"name":"To Valdoria","type":"door","x":2056,"y":3982,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"valdoria"},{"name":"toX","type":"float","value":2056},{"name":"toY","type":"float","value":270}]},{"id":6,"name":"To Brightforge","type":"door","x":3976,"y":782,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"brightforge"},{"name":"toX","type":"float","value":2056},{"name":"toY","type":"float","value":334}]},{"id":7,"name":"odda","type":"npc","x":2088,"y":782,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"odda"},{"name":"sprite","type":"string","value":"odda"}]},{"id":8,"name":"nell","type":"npc","x":2280,"y":846,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"nell"},{"name":"sprite","type":"string","value":"nell"}]},{"id":9,"name":"merric","type":"npc","x":1896,"y":1390,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"merric"},{"name":"sprite","type":"string","value":"soren"}]},{"id":10,"name":"edda","type":"npc","x":2344,"y":1390,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"edda"},{"name":"sprite","type":"string","value":"freya"}]},{"id":11,"name":"harl","type":"npc","x":2632,"y":718,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"harl"},{"name":"sprite","type":"string","value":"ivar"}]},{"id":12,"name":"tova","type":"npc","x":360,"y":2126,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"tova"},{"name":"sprite","type":"string","value":"signe"}]},{"id":13,"name":"graymoor-yard","type":"bind","x":1992,"y":910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":14,"name":"fire","type":"prop","x":1992,"y":814,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":15,"name":"banner","type":"prop","x":2056,"y":558,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":16,"name":"Graymoor Hold","type":"sign","x":1736,"y":654,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Graymoor Hold, castle of the mud country, just inland of the port. Odda Venn is warden. The court is safe. North is Hoffender. South is Valdoria and Blackpine Tower. East, the Lightbrune Pass goes to Brightforge. West, Thornhaven harbor faces the sea. Sit here if you want a fall to bring you back."}]},{"id":17,"name":"North road","type":"sign","x":2152,"y":206,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Hoffender and the Frostmere Wilds. The cold starts again past this line. The same road comes back. Wyrmrest is the east road out of those wilds, under the Ogre Highlands."}]},{"id":18,"name":"East track","type":"sign","x":3784,"y":1646,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The grass track back to the southeast of the Frostmere Wilds. It does not skip the hold. It only comes in from the side."}]},{"id":19,"name":"Lightbrune Pass","type":"sign","x":3528,"y":686,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Lightbrune Pass. Brightforge, hold of the Lightbrune clan, is through this gate. The slopes outside it are a young road. Ashdeep and Veilspire are deeper, and those mine doors are shut."}]},{"id":20,"name":"Thornhaven harbor","type":"sign","x":488,"y":1998,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Thornhaven harbor, on the west coast. Tova keeps the quay. This water is not the golden trade route. That ship leaves the east dock of Valdoria, toward the Wood Elf coast, and crosses to Vaelmoor."}]},{"id":21,"name":"South road","type":"sign","x":2184,"y":3694,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Valdoria, and Blackpine Tower, lie south. The mud thins. The pines do not. Eldenmoor is not this road. It is across the water."}]},{"id":22,"name":"Thornhaven","type":"label","x":1288,"y":2894,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":23,"name":"Graymoor Hold","type":"label","x":2056,"y":398,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":24,"na