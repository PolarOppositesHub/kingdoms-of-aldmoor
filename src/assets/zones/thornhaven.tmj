":1992,"y":814,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":15,"name":"banner","type":"prop","x":2056,"y":558,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":16,"name":"Graymoor Hold","type":"sign","x":1736,"y":654,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Graymoor Hold, castle of the mud country, just inland of the port. Odda Venn is warden. The court is safe. North is Hoffender. South is Valdoria and Blackpine Tower. East, the Lightbrune Pass goes to Brightforge. West, Thornhaven harbor faces the sea. Sit here if you want a fall to bring you back."}]},{"id":17,"name":"North road","type":"sign","x":2152,"y":206,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Hoffender and the Frostmere Wilds. The cold starts again past this line. The same road comes back. Wyrmrest is the east road out of those wilds, under the Ogre Highlands."}]},{"id":18,"name":"East track","type":"sign","x":3784,"y":1646,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The grass track back to the southeast of the Frostmere Wilds. It does not skip the hold. It only comes in from the side."}]},{"id":19,"name":"Lightbrune Pass","type":"sign","x":3528,"y":686,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Lightbrune Pass. Brightforge, hold of the Lightbrune clan, is through this gate. The slopes outside it are a young road. Ashdeep and Veilspire are deeper, and those mine doors are shut."}]},{"id":20,"name":"Thornhaven harbor","type":"sign","x":488,"y":1998,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Thornhaven harbor, on the west coast. Tova keeps the quay. This water is not the golden trade route. That ship leaves the east dock of Valdoria, toward the Wood Elf coast, and crosses to Vaelmoor."}]},{"id":21,"name":"South road","type":"sign","x":2184,"y":3694,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Valdoria, and Blackpine Tower, lie south. The mud thins. The pines do not. Eldenmoor is not this road. It is across the water."}]},{"id":22,"name":"Thornhaven","type":"label","x":1288,"y":2894,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":23,"name":"Graymoor Hold","type":"label","x":2056,"y":398,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":24,"name":"aldric","type":"npc","x":2184,"y":686,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"aldric"},{"name":"sprite","type":"string","value":"aldric"}]},{"id":25,"name":"wren","type":"npc","x":1736,"y":782,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"wren"},{"name":"sprite","type":"string","value":"wren"}]},{"id":26,"name":"keel","type":"npc","x":2472,"y":782,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"keel"},{"name":"sprite","type":"string","value":"keel"}]},{"id":27,"name":"well","type":"prop","x":1544,"y":750,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","v