he Eldenweald. Hares and foxes near the wall. Wolves, then poachers, then the Amber Hart where the trees thicken. The woods end. They do not become Valdoria. Maerthun is across the water."}]},{"id":27,"name":"The road north","type":"sign","x":2184,"y":398,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Eldenweald thins and stops. There is no road from here to Valdoria. The golden trade ship is at the east dock of the city."}]},{"id":28,"name":"Vaelmoor dock","type":"sign","x":3368,"y":3342,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Eldenmoor dock, on Vaelmoor. The ship is the golden trade route. It crosses to the Wood Elf coast of Maerthun and lands at the east dock of Valdoria. You do not walk to Blackpine Tower."}]},{"id":29,"name":"Eldenmoor","type":"label","x":2056,"y":3566,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":30,"name":"Eldenweald","type":"label","x":1288,"y":974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":31,"name":"meadow_hare","type":"mob","x":2008,"y":2366,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"meadow_hare"},{"name":"sprite","type":"string","value":"hare"}]},{"id":32,"name":"meadow_hare","type":"mob","x":2120,"y":2318,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"meadow_hare"},{"name":"sprite","type":"string","value":"hare"}]},{"id":33,"name":"meadow_hare","type":"mob","x":1992,"y":2254,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"meadow_hare"},{"name":"sprite","type":"string","value":"hare"}]},{"id":34