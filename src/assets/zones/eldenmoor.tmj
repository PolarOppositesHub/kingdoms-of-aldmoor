rue,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Eldenmoor. The outer court holds the halls: Selne for clerics, Miris for enchanters, Adel for paladins, Quen for magicians, Maeriel for wizards. The castle at the center is the house of Queen Ellewynn XVI. Her steward, Halden, stands in the court. The north gate is the Eldenweald."}]},{"id":16,"name":"North gate","type":"sign","x":2312,"y":2414,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Eldenweald. Hares and foxes near the wall. Wolves, then poachers, then the Amber Hart where the trees thicken. The woods end. They do not become Valdoria. Maerthun is across the water."}]},{"id":17,"name":"The road north","type":"sign","x":2184,"y":398,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Eldenweald thins and stops. There is no road from here to Valdoria. The golden trade ship is at the east dock of the city."}]},{"id":18,"name":"Vaelmoor dock","type":"sign","x":3368,"y":3342,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Eldenmoor dock, on Vaelmoor. The ship is the golden trade route. It crosses to the Wood Elf coast of Maerthun and lands at the east dock of Valdoria. You do not walk to Blackpine Tower."}]},{"id":19,"name":"Eldenmoor","type":"label","x":2056,"y":3566,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":20,"name":"Eldenweald","type":"label","x":1288,"y":974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":21,"name":"meadow_hare","type":"mob","x":776,"y":2254,"width":0,"height":0,"rotation":0,"visible":tr