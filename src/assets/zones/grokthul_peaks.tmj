string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"grokthul"},{"name":"toX","type":"float","value":2056},{"name":"toY","type":"float","value":366}]},{"id":3,"name":"watch","type":"spawn","x":2056,"y":3054,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":4,"name":"tuskwatch","type":"bind","x":2248,"y":2990,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":5,"name":"skaal","type":"npc","x":2056,"y":2830,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"skaal"},{"name":"sprite","type":"string","value":"skaal"}]},{"id":6,"name":"tuk_watch","type":"npc","x":1768,"y":2894,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"tuk_watch"},{"name":"sprite","type":"string","value":"folk_ogre_guard"},{"name":"ambient","type":"bool","value":true}]},{"id":7,"name":"ogr_ash","type":"npc","x":2408,"y":2958,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"ogr_ash"},{"name":"sprite","type":"string","value":"folk_ogre_folk"},{"name":"ambient","type":"bool","value":true}]},{"id":8,"name":"yag_hide","type":"npc","x":1928,"y":3150,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"yag_hide"},{"name":"sprite","type":"string","value":"folk_ogre_merchant"},{"name":"ambient","type":"bool","value":true}]},{"id":9,"name":"amm_old","type":"npc","x":2248,"y":2734,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"amm_old"},{"name":"sprite","type":"string","value":"folk_ogre_elder"},{"name":"ambient","type":"bool","value":true}]},{"id":10,"name":"fire","type":"prop","x":1864,"y":2894,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type"