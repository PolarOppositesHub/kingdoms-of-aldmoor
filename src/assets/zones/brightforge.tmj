},{"id":12,"name":"dunn","type":"npc","x":1800,"y":1742,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"dunn"},{"name":"sprite","type":"string","value":"dunn"}]},{"id":13,"name":"otta","type":"npc","x":2312,"y":1742,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"otta"},{"name":"sprite","type":"string","value":"otta"}]},{"id":14,"name":"fire","type":"prop","x":1864,"y":1102,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":15,"name":"banner","type":"prop","x":2248,"y":750,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":16,"name":"Brightforge","type":"sign","x":1608,"y":718,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Brightforge, hold of the Lightbrune clan, northernmost of the Dwarven Mountains. King Durgan Ashbeard keeps the court. The halls are the anvil, the lamp, the oath, the quiet stair, and the red gallery. North, the pass returns to Graymoor Hold. South, the slopes. The deep doors to Ashdeep and Veilspire are shut."}]},{"id":17,"name":"Lightbrune Pass","type":"sign","x":2184,"y":302,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The pass north. Graymoor Hold and Thornhaven are a short walk. The same road comes back. Hoffender and the Frostmere Wilds lie beyond the hold."}]},{"id":18,"name":"The slopes","type":"sign","x":2184,"y":1998,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Lightbrune Slopes. Hares and beetles by the wall, wolves, then bandits, then Kragg Ashhand. Old Slate is the bear that is rarely seen. This is a young road. The pass north is not."}]},{"id":19,"name":"Ashdeep","type":"seam","x":776,"y":3790,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"A mine door, barred. Ashdeep, hold of the Darkbrune clan, is deeper in the mountains. The tunnel is shut."}]},{"id":20,"name":"Veilspire","type":"seam","x":3368,"y":3790,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"A second mine door, barred. Veilspire, hold of the Mistbrune clan, lies further along the deep tunnels. That door is shut."}]},{"id":21,"name":"Brightforge","type":"label","x":2056,"y":494,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":22,"name":"Lightbrune Slopes","type":"label","x":2056,"y":2574,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":23,"name":"anvil","type":"prop","x":1736,"y":1230,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"anvil"}]},{"id":24,"name":"crate","type":"prop","x":2408,"y":1230,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"crate"}]},{"id":25,"name":"cart","type":"prop","x":1608,"y":1454,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"cart"}]},{"id":26,"name":"stall","type":"prop","x":2568,"y":1262,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"stall"}]},{"id":27,"name":"barrel","type":"prop","x":1384,"y":1614,"width":0,"height":0,"rotation":0,"visible