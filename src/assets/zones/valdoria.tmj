1,"name":"To Thornhaven","type":"door","x":2056,"y":142,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"thornhaven"},{"name":"toX","type":"float","value":2056},{"name":"toY","type":"float","value":3822}]},{"id":2,"name":"north","type":"spawn","x":2056,"y":270,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":3,"name":"Trade ship","type":"door","x":3720,"y":1806,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"eldenmoor"},{"name":"toX","type":"float","value":3496},{"name":"toY","type":"float","value":3438}]},{"id":4,"name":"osric","type":"npc","x":3048,"y":2126,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"osric"},{"name":"sprite","type":"string","value":"osric"}]},{"id":5,"name":"pike","type":"npc","x":2824,"y":2574,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pike"},{"name":"sprite","type":"string","value":"soren"}]},{"id":6,"name":"cress","type":"npc","x":3272,"y":2574,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"cress"},{"name":"sprite","type":"string","value":"freya"}]},{"id":7,"name":"wynn","type":"npc","x":2696,"y":1934,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"wynn"},{"name":"sprite","type":"string","value":"signe"}]},{"id":8,"name":"joren","type":"npc","x":3656,"y":1870,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"joren"},{"name":"sprite","type":"string","value":"joren"}]},{"id":9,"name":"blackpine-yard","type":"bind","x":3144,"y":2190,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":10,"name":"banner","type":"prop","x":3080,"y":2062,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":11,"name":"crate","type":"prop","x":2824,"y":2190,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"crate"}]},{"id":12,"name":"Blackpine Tower","type":"sign","x":2632,"y":2414,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Blackpine Tower, castle in the central pines, inside the wood-elf free-passage ring. Osric Blackpine is warden. The court is safe. North is Thornhaven. The east dock is the golden trade route: a ship to Vaelmoor, and to Eldenmoor. You do not walk to the elves. South, the pines go on toward Saltmere. That coast is not open. East of the pines, the forest road is open: Ironhollow Keep, then the Greenreach and Canipure. King Aldric Valdor rules Valdoria, and the castle lords answer to him."}]},{"id":13,"name":"North road","type":"sign","x":2184,"y":238,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Thornhaven, Graymoor Hold, and beyond them the snow of Hoffender. The road is the same one you walked down. Brightforge is the mountain pass east of Graymoor."}]},{"id":14,"name":"South road","type":"sign","x":2184,"y":3694,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The pines continue. Saltmere Castle is on the south coast, and that road is not open. Eldenmoor is not this way. The ship is at the east dock."}]},{"id":15,"name":"Golden route","type":"sign","x":3592,"y":1678,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The golden trade route. The ship crosses the water east of Maerthun, by the Wood Elf coast and Canipure, and lands at Eldenmoor on Vaelmoor. The same ship comes back."}]},{"id":16,"name":"Valdoria","type":"label","x":1288,"y":1294,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":17,"name":"Blackpine Tower","type":"label","x":3080,"y":1550,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":18,"name":"pine_stag","type":"mob","x":776,"y":654,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pine_stag"},{"name":"sprite","type":"string","value":"stag"}]},{"id":19,"name":"pine_stag","type":"mob","x":1288,"y":910,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pine_stag"},{"name":"sprite","type":"string","value":"stag"}]},{"id":20,"name":"pine_stag","type":"mob","x":2728,"y":782,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pine_stag"},{"name":"sprite","type":"string","value":"stag"}]},{"id":21,"name":"pine_stag","type":"mob","x":3208,"y":974,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pine_stag"},{"name":"sprite","type":"string","value":"stag"}]},{"id":22,"name":"pine_stag","type":"mob","x":968,"y":3214,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"pine_stag"},{"name":"sprite","type":"string","value":"stag"}]},{"id":23,"name":"pine_stag","type":"mob","x":2888,"y":3374,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type