nt":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":9,"name":"crate","type":"prop","x":2152,"y":3118,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"crate"}]},{"id":10,"name":"barrel","type":"prop","x":1896,"y":3118,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"barrel"}]},{"id":11,"name":"Hearthpass","type":"sign","x":1864,"y":3310,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Hearthpass. Kara Holm keeps the fire for Jarl Freya. The palisade is the end of an ogre's nerve. Sit here. Ask Kara if you want a fall to bring you back to this yard."}]},{"id":12,"name":"Frostfang Reach","type":"label","x":1992,"y":3662,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":13,"name":"Hearthpass","type":"label","x":2024,"y":2894,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":14,"name":"Broken Fangs","type":"label","x":1032,"y":1902,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":15,"name":"Tarn of Shards","type":"label","x":3144,"y":1966,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":16,"name":"The Fang","type":"label","x":1736,"y":366,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":17,"name":"Broken Fangs","type":"sign","x":840,"y":2030,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Broken Fangs. Ogre camps in the rock. Grimhild the Toll takes the west road and does not give receipts."}]},{"id":18,"name":"Tarn of Shards","type":"sign","x":2728,"y":2414,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"Tarn of Shards. The ice holds. The water in the middle does not. Ashjaw walks the shore when the tarn feels like company."}]},{"id":19,"name":"The Fang","type":"sign","x":1800,"y":750,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Fang. The cleft of Vargan Frostfang, war-chief of the highland ogres. Past his mouth of stone the Black Ice starts: three caverns, and Ysolde at the bottom of them. She is not him."}]},{"id":20,"name":"circle-0","type":"prop","x":1112,"y":1966,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock_small"}]},{"id":21,"name":"circle-1","type":"prop","x":1096,"y":2014,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":22,"name":"circle-2","type":"prop","x":1032,"y":2030,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock_small"}]},{"id":23,"name":"circle-3","type":"prop","x":968,"y":2014,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":24,"name":"circle-4","type":"prop","x":952,"y":1966,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock_small"}]},{"id":25,"name":"circle-5","type":"prop","x":968,"y":1918,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]},{"id":26,"name":"circle-7","type":"prop","x":1096,"y":1918,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"rock"}]