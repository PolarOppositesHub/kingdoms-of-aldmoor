idth":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"valdoria"},{"name":"toX","type":"float","value":3784},{"name":"toY","type":"float","value":654}]},{"id":2,"name":"To the Greenreach","type":"door","x":3944,"y":590,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"toZone","type":"string","value":"canipure"},{"name":"toX","type":"float","value":296},{"name":"toY","type":"float","value":2062}]},{"id":3,"name":"court","type":"spawn","x":2184,"y":1550,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":4,"name":"ironhollow-court","type":"bind","x":2056,"y":1678,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[]},{"id":5,"name":"edric","type":"npc","x":2184,"y":1422,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"edric"},{"name":"sprite","type":"string","value":"edric"}]},{"id":6,"name":"oswin","type":"npc","x":2120,"y":2062,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"oswin"},{"name":"sprite","type":"string","value":"oswin"}]},{"id":7,"name":"cald","type":"npc","x":2504,"y":1614,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"cald"},{"name":"sprite","type":"string","value":"cald"}]},{"id":8,"name":"bessa","type":"npc","x":1800,"y":1614,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"defId","type":"string","value":"bessa"},{"name":"sprite","type":"string","value":"bessa"}]},{"id":9,"name":"banner","type":"prop","x":2312,"y":1070,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"banner"}]},{"id":10,"name":"fire","type":"prop","x":1992,"y":1550,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"firepit"}]},{"id":11,"name":"Ironhollow Keep","type":"sign","x":1736,"y":1038,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_hall"},{"name":"text","type":"string","value":"Ironhollow Keep. Lord Edric Hollen keeps this castle for King Aldric Valdor. The court is safe. The forest road along the north runs west to Blackpine Tower and east into the Greenreach, and on to Canipure. South, the Ironhollow Hills. Levels climb with the road. This is the second road east of the pines."}]},{"id":12,"name":"West road","type":"sign","x":456,"y":462,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"West, through the pines, to Blackpine Tower and Valdoria. The same forest runs the other way, north of this keep, to the Wood Elf lands. King Aldric Valdor rules the kingdom these castles answer to."}]},{"id":13,"name":"East road","type":"sign","x":3528,"y":462,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"East, the forest continues into the Greenreach, then Canipure on the coast that faces Vaelmoor. The hills south of the keep are not that forest. They are the harder road."}]},{"id":14,"name":"The hills","type":"sign","x":2408,"y":2702,"width":0,"height":0,"rotation":0,"visible":true,"point":true,"properties":[{"name":"sprite","type":"string","value":"sign_wilds"},{"name":"text","type":"string","value":"The Ironhollow Hills, levels eighteen to twenty-eight. Wolves, boars, brigands, then Rusk the Hollow. Old Marrow is the rare of the deep hills and does not show often. The keep yard is the safe ground."}]},{"